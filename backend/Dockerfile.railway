# Railway image for the backend services: web, telegram_bot, worker.
#
# Build context is the REPO ROOT, not backend/: seed_deck / seed_runes read
# Path(__file__).parents[5] / "data" / "deck", which from
# /app/apps/<app>/management/commands/ resolves to /data/deck. docker-compose
# gets that layout by bind-mounting ./data:/data; Railway has no mounts, so the
# seed data is baked into the image instead.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY data/ /data/
COPY backend/ .

# Every Railway service overrides this with its own startCommand
# (backend/railway.web.json, railway.bot.json, railway.worker.json).
CMD ["sh", "start-railway-web.sh"]
