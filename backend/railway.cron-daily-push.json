{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.railway",
    "watchPatterns": ["backend/**"]
  },
  "deploy": {
    "startCommand": "python manage.py send_daily_push",
    "cronSchedule": "0 8 * * *",
    "restartPolicyType": "NEVER"
  }
}
